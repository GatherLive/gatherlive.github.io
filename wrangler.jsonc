{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gather-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
    "ALLOWED_ORIGINS": "http://localhost:8000,http://127.0.0.1:8000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GiveawayRoom"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountRooms"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GiveawayRoom",
        "AccountRooms"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CONNECTION_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
